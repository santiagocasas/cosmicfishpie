# camb vs class (photo), CLASS ncdm precision sensitivity variant (non-canonical)
# NOTE: earlier local notes mistakenly called this the paper's photo "HP" profile.
# Per SensitivityNeutrinos.htm (arXiv:2405.06047v1) Appendix, the paper's actual
# photo HP is l_max_ncdm=25, ncdm_fluid_trigger_tau_over_tau_k=100 -- exactly what
# case 03.2 already uses. This case instead uses a stricter, non-paper profile
# (l_max_ncdm=40, trigger=90, matching the spectro UHP-style local
# photometric_pess_*_HP.param files in Euclid_KP_nu, not the paper's photo HP).
# Everything else is identical to case 03.2 (LCDM + free mnu, Neff), for a direct
# A/B comparison isolating this stricter CLASS ncdm precision profile's effect on
# the mnu marginalized deviation.
MODE="photo"
CODE_A="camb"
CODE_B="class"
YAML_A="${REPO_ROOT}/cosmicfishpie/configs/default_boltzmann_yaml_files/camb/paper_mnuvalidation.yaml"
YAML_B="${REPO_ROOT}/cosmicfishpie/configs/default_boltzmann_yaml_files/class/paper_mnuvalidation_photo_HP.yaml"
COMMON_SPECS_JSON="${REPO_ROOT}/scripts/validation_configs/common_specs_paper_LCDM_mnu_Neff.json"
PLOT=true
REPORT_SINGLE=true
SIGMA_THRESHOLD=10
