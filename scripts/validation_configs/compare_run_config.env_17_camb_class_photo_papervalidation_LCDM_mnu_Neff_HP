# camb vs class (photo), paper neutrino validation (arXiv:2405.06047v1), LCDM + free mnu, Neff
# CLASS side uses the paper-faithful photo "HP" ncdm precision profile
# (l_max_ncdm=40, ncdm_fluid_trigger_tau_over_tau_k=90, matching the historical
# photometric_pess_mnu+Neff_HP.param / class_nulcdm_HP.ini in Euclid_KP_nu), instead
# of the lower-precision defaults in paper_mnuvalidation_photo.yaml (l_max_ncdm=25,
# trigger=100). Everything else is identical to case 11, for a direct A/B comparison
# isolating the CLASS ncdm precision profile's effect on the mnu marginalized deviation.
MODE="photo"
CODE_A="camb"
CODE_B="class"
YAML_A="${REPO_ROOT}/cosmicfishpie/configs/default_boltzmann_yaml_files/camb/paper_mnuvalidation.yaml"
YAML_B="${REPO_ROOT}/cosmicfishpie/configs/default_boltzmann_yaml_files/class/paper_mnuvalidation_photo_HP.yaml"
COMMON_SPECS_JSON="${REPO_ROOT}/scripts/validation_configs/common_specs_paper_LCDM_mnu_Neff.json"
PLOT=true
REPORT_SINGLE=true
SIGMA_THRESHOLD=10
